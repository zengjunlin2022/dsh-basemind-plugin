{
  "name": "dsh-basemind-plugin",
  "version": "0.1.1",
  "description": "Workspace-aware BaseMind MCP bridge for DeepSeek Harness: every session gets BaseMind's code-intelligence tools for the repository it works in, with no MCP row to configure.",
  "type": "module",
  "main": "index.js",
  "author": "Ken",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zengjunlin2022/dsh-basemind-plugin.git"
  },
  "homepage": "https://github.com/zengjunlin2022/dsh-basemind-plugin#readme",
  "bugs": {
    "url": "https://github.com/zengjunlin2022/dsh-basemind-plugin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "basemind",
    "mcp",
    "mcp-client",
    "code-intelligence",
    "code-search",
    "workspace"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.20.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "volta": {
    "node": "24.20.0"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "check": "node scripts/check-syntax.mjs && node scripts/check-manifest.mjs",
    "check:pack": "npm pack --json --dry-run > pack.json && node scripts/check-pack.mjs pack.json",
    "verify": "npm run check && npm run check:pack && npm test",
    "pack": "npm pack"
  }
}
