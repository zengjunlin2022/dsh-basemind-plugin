{
  "name": "dsh-basemind-plugin",
  "version": "0.1.1",
  "description": "Workspace-aware BaseMind MCP bridge for DeepSeek Harness that starts its own per-workspace basemind serve relay, so sessions get BaseMind's code-intelligence tools without configuring an MCP server.",
  "type": "module",
  "main": "index.js",
  "author": "Ken",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zengjunlin2022/dsh-basemind-plugin.git"
  },
  "homepage": "https://github.com/zengjunlin2022/dsh-basemind-plugin#readme",
  "bugs": {
    "url": "https://github.com/zengjunlin2022/dsh-basemind-plugin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "basemind",
    "mcp",
    "code-intelligence"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=24.20.0",
    "dsh": ">=0.2.1-rc.3 <0.3.0-0"
  },
  "volta": {
    "node": "24.20.0"
  },
  "scripts": {
    "test": "node --test"
  }
}
