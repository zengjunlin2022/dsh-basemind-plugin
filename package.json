{
  "name": "dsh-basemind-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace-aware BaseMind MCP bridge for DeepSeek Harness that starts its own per-workspace basemind serve relay, so sessions get BaseMind's code-intelligence tools without configuring an MCP server.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.2.1-rc.3",
      "node": ">=22"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test"
  }
}
